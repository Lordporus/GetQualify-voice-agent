# =============================================================================
# RapidX Voice. Environment template.
# Copy this file to .env and fill in the real values. The .env file is
# gitignored and its keys never reach the browser. Placeholders only here.
# No em dashes anywhere in this codebase. Use commas or periods.
# =============================================================================

# ---- Voice engine: Rumik silk TTS (LIVE) ------------------------------------
# The hook. Roughly 20x cheaper than ElevenLabs. Sits behind Cloudflare, so the
# server always sends a browser User-Agent. Do not remove that, it 403s otherwise.
RUMIK_API_KEY=your_rumik_api_key_here
TTS_PROVIDER=rumik
TTS_MODEL=mulberry
# Provider-specific fallback, used when TTS_MODEL is unset.
RUMIK_MODEL=mulberry

# ---- Live transcription: Deepgram Nova-3 -----------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3

# ---- Brain: Groq Llama 3.3 70B ---------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Provider-specific fallback, used when LLM_MODEL is unset.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional comma-separated allowlist for tenant or agent model selection.
# GROQ_ALLOWED_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b

# ---- Server ----------------------------------------------------------------
PORT=8787

# ---- Database: PostgreSQL (Default) or JSON file store --------------------
# DB_DRIVER: 'postgres' for PostgreSQL, or 'json' for legacy local file store.
DB_DRIVER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/getqualify
# Used by test runners to spin up disposable testing databases:
# TEST_ROOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Optional local/test bootstrap. Disabled unless both are explicitly set.
# Use at least 12 characters for the password.
# TEST_USER_EMAIL=test-admin@example.com
# TEST_USER_PASSWORD=
# TEST_USER_TENANT=RapidX Test
# TEST_USER_SUPER_ADMIN=false

# ---- PayU India hosted checkout. Optional. -------------------------------
# PAYU_ENV=test
# PAYU_KEY=
# PAYU_SALT=
# RAPIDX_PUBLIC_URL=https://voice.example.com

# ---- Telephony: VoBiz through Dograh (LIVE) --------------------------------
# The dashboard talks only to Dograh, never to the raw VoBiz API. Create a
# dedicated organization API key in Dograh and keep it server-side here.
DOGRAH_BASE_URL=https://your-dograh-host.example.com
DOGRAH_API_KEY=your_dedicated_dograh_api_key
# Public embed token for the published browser-call workflow. It remains
# server-side; browsers receive a short-lived session token.
DOGRAH_EMBED_TOKEN=your_published_workflow_embed_token
DOGRAH_WORKFLOW_ID=1
# Required for no_recording phone calls. The upstream workflow must have
# recording and transcript retention disabled.
DOGRAH_NO_RECORDING_WORKFLOW_ID=
DOGRAH_TELEPHONY_CONFIG_ID=1
DOGRAH_PHONE_NUMBER_ID=1
# Optional display fallback. Live status reads the number from Dograh.
VOBIZ_NUMBER=91XXXXXXXXXX

# ---- Calendar: optional HVAC Desk booking ----------------------------------
# Server-side Cal.com API key. Leave blank to keep booking disabled.
# CALCOM_API_KEY=

# ---- Billing: PayU India Hosted Checkout ----------------------------------
# Use the merchant key and salt for classic Hosted Checkout. Keep both on the
# server. PAYU_ENV must be test until a low-value end-to-end test passes.
PAYU_ENV=test
PAYU_KEY=
PAYU_SALT=
# =============================================================================
# Optional implemented providers. Selecting a provider never sends its key to
# the browser. Restart the server after changing the default.
# =============================================================================

# ---- LLM alternative, fully wired ----
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_ALLOWED_MODELS=gemini-flash-latest,gemini-2.5-flash
# To activate it:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# ElevenLabs, Sarvam, Claude, Zoom, and Twilio are not advertised because this
# repository does not ship production adapters for them. Implement the uniform
# adapter contract in lib/providers.js and register it before selecting it.

# =============================================================================
# Phase 4: External Integrations (Calendar, SMS, Email, Object Storage)
# =============================================================================

# ---- Google Calendar OAuth2 (free API, per-tenant calendar booking) ---------
# Generate credentials in Google Cloud Console -> APIs & Services -> Credentials
# Add CALENDAR_REDIRECT_URI to Authorized Redirect URIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALENDAR_REDIRECT_URI=http://localhost:8787/api/integrations/calendar/callback
# 32-byte hex string used for AES-256-GCM token encryption at rest:
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# ---- SendGrid Email (free tier: 100 emails/day forever) ---------------------
# Used for automated call summaries, transcripts, booking confirmations, and invoices.
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@getqualify.ai

# ---- MSG91 SMS — India (free trial: ~100 SMS credits) -----------------------
# India-optimized transactional SMS. REST API called via zero-dependency HTTPS.
# DLT NOTE: Indian telecom regulations require Distributed Ledger Technology (DLT)
# registration for production transactional SMS sender IDs. Dev/test uses trial credits.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GQALFY
MSG91_MISSED_CALL_TEMPLATE_ID=
MSG91_BOOKING_TEMPLATE_ID=
MSG91_REMINDER_TEMPLATE_ID=

# ---- Vultr Object Storage (S3-compatible, $6/mo for 1TB + 1TB transfer) ----
# Used for secure call recording storage with tenant-scoped keys and pre-signed URLs.
# Uses @aws-sdk/client-s3 with custom Vultr endpoint and forcePathStyle: true.
VULTR_ACCESS_KEY_ID=your_vultr_storage_access_key
VULTR_SECRET_ACCESS_KEY=your_vultr_storage_secret_key
VULTR_ENDPOINT_URL=https://blr1.vultrobjects.com
VULTR_BUCKET_NAME=getqualify-recordings
VULTR_REGION=us-east-1

# ---- Dograh Post-Call Webhook Secret ----------------------------------------
# Shared secret for validating incoming call-completed events from Dograh.
# Verified against X-Dograh-Webhook-Secret request header.
DOGRAH_WEBHOOK_SECRET=your_dograh_webhook_shared_secret

# =============================================================================
# Phase 5: Monitoring & Error Tracking
# =============================================================================
# ---- Sentry Error Monitoring (free tier: 5,000 events/month) ----------------
# Leave blank to disable Sentry error reporting (server gracefully no-ops).
# When set, captures unhandled exceptions and HTTP 500 router errors.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=

