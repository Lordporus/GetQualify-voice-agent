# =============================================================================
# RapidX Voice. Environment template.
# Copy this file to .env and fill in the real values. The .env file is
# gitignored and its keys never reach the browser. Placeholders only here.
# No em dashes anywhere in this codebase. Use commas or periods.
# =============================================================================

# ---- Voice engine: Rumik silk TTS (LIVE) ------------------------------------
# The hook. Roughly 20x cheaper than ElevenLabs. Sits behind Cloudflare, so the
# server always sends a browser User-Agent. Do not remove that, it 403s otherwise.
RUMIK_API_KEY=your_rumik_api_key_here
TTS_PROVIDER=rumik
TTS_MODEL=mulberry
# Provider-specific fallback, used when TTS_MODEL is unset.
RUMIK_MODEL=mulberry

# ---- Live transcription: Deepgram Nova-3 -----------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3

# ---- Brain: Groq Llama 3.3 70B ---------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Provider-specific fallback, used when LLM_MODEL is unset.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional comma-separated allowlist for tenant or agent model selection.
# GROQ_ALLOWED_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b

# ---- Server ----------------------------------------------------------------
PORT=8787

# Optional local/test bootstrap. Disabled unless both are explicitly set.
# Use at least 12 characters for the password.
# TEST_USER_EMAIL=test-admin@example.com
# TEST_USER_PASSWORD=
# TEST_USER_TENANT=RapidX Test
# TEST_USER_SUPER_ADMIN=false

# ---- PayU India hosted checkout. Optional. -------------------------------
# PAYU_ENV=test
# PAYU_KEY=
# PAYU_SALT=
# RAPIDX_PUBLIC_URL=https://voice.example.com

# ---- Telephony: VoBiz through Dograh (LIVE) --------------------------------
# The dashboard talks only to Dograh, never to the raw VoBiz API. Create a
# dedicated organization API key in Dograh and keep it server-side here.
DOGRAH_BASE_URL=https://your-dograh-host.example.com
DOGRAH_API_KEY=your_dedicated_dograh_api_key
# Public embed token for the published browser-call workflow. It remains
# server-side; browsers receive a short-lived session token.
DOGRAH_EMBED_TOKEN=your_published_workflow_embed_token
DOGRAH_WORKFLOW_ID=1
# Required for no_recording phone calls. The upstream workflow must have
# recording and transcript retention disabled.
DOGRAH_NO_RECORDING_WORKFLOW_ID=
DOGRAH_TELEPHONY_CONFIG_ID=1
DOGRAH_PHONE_NUMBER_ID=1
# Optional display fallback. Live status reads the number from Dograh.
VOBIZ_NUMBER=91XXXXXXXXXX

# ---- Calendar: optional HVAC Desk booking ----------------------------------
# Server-side Cal.com API key. Leave blank to keep booking disabled.
# CALCOM_API_KEY=

# ---- Billing: PayU India Hosted Checkout ----------------------------------
# Use the merchant key and salt for classic Hosted Checkout. Keep both on the
# server. PAYU_ENV must be test until a low-value end-to-end test passes.
PAYU_ENV=test
PAYU_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_merchant_salt
# =============================================================================
# Optional implemented providers. Selecting a provider never sends its key to
# the browser. Restart the server after changing the default.
# =============================================================================

# ---- LLM alternative, fully wired ----
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_ALLOWED_MODELS=gemini-flash-latest,gemini-2.5-flash
# To activate it:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# ElevenLabs, Sarvam, Claude, Zoom, and Twilio are not advertised because this
# repository does not ship production adapters for them. Implement the uniform
# adapter contract in lib/providers.js and register it before selecting it.
