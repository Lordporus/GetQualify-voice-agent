# =============================================================================
# RapidX Voice Agent Stack. Copy to .env and fill in. .env is gitignored.
# No em dashes anywhere in this codebase. Use commas or periods.
# =============================================================================

# ---- Target VPS -------------------------------------------------------------
# Fresh Ubuntu 24.04, 4GB RAM recommended. 2GB works with the swapfile the
# deploy script adds. Ports 22, 80, 443 open.
VPS_IP=
SSH_KEY=~/.ssh/id_rsa

# Derived automatically as the dashed form of VPS_IP, e.g. 203-0-113-10
# Gives you HTTPS with no DNS setup. Browser mic access requires HTTPS.
# DOGRAH_HOST=<dashed-ip>.sslip.io

# ---- Dograh console login ---------------------------------------------------
# Created by signing up in the browser at STEP 3. The first signup owns org 1.
# Use this SAME account for API calls and for the browser, or the console will
# look empty while the API shows everything.
DOGRAH_EMAIL=
DOGRAH_PASSWORD=

# Dedicated org API key used by RapidX Voice Studio. Prefer this over storing
# the Dograh admin password in the dashboard container.
DOGRAH_BASE_URL=
DOGRAH_API_KEY=
DOGRAH_WORKFLOW_ID=
DOGRAH_TELEPHONY_CONFIG_ID=
DOGRAH_PHONE_NUMBER_ID=

# ---- Telephony: Vobiz -------------------------------------------------------
# console.vobiz.ai. Plivo-compatible API, header auth X-Auth-ID / X-Auth-Token.
# Leave VOBIZ_APPLICATION_ID BLANK. Dograh auto-creates its own application and
# points the answer_url at your box. Reusing another product's application_id is
# the number one cause of a call that connects and then sits in silence.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_NUMBER=
VOBIZ_APPLICATION_ID=

# ---- Speech to text: Deepgram ----------------------------------------------
# console.deepgram.com. nova-3-general with language=multi handles Hinglish.
DEEPGRAM_API_KEY=

# ---- Brain: Groq ------------------------------------------------------------
# console.groq.com. Fast enough that the pause before a reply is not noticeable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Voice: Rumik silk ------------------------------------------------------
# rumik.ai. mulberry is the fast model, muga is the expressive one.
# Sits behind Cloudflare, the server always sends a browser User-Agent.
RUMIK_API_KEY=
RUMIK_MODEL=mulberry
RUMIK_VOICE=ira

# ---- Verification -----------------------------------------------------------
# The phone you will actually answer to confirm the stack works.
TEST_NUMBER=

# =============================================================================
# Dashboard & Production Stack (deploy/06-deploy-dashboard.sh)
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DASHBOARD_PORT=8787

# ---- Database: PostgreSQL ---------------------------------------------------
DB_DRIVER=postgres
POSTGRES_USER=getqualify
POSTGRES_DB=getqualify_voice
DB_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://getqualify:your_secure_postgres_password_here@postgres:5432/getqualify_voice

# ---- Network, Proxy & Security ---------------------------------------------
# Required in production behind an SSL reverse proxy (Nginx, Caddy, Cloudflare).
# PUBLIC_ORIGIN=https://voice.example.com
# GETQUALIFY_PUBLIC_URL=https://voice.example.com
TRUST_PROXY=1

# ---- External Integrations (Phase 4) ---------------------------------------
# SendGrid Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@getqualify.ai

# MSG91 SMS (India Transactional)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GQALFY
MSG91_MISSED_CALL_TEMPLATE_ID=
MSG91_BOOKING_TEMPLATE_ID=
MSG91_REMINDER_TEMPLATE_ID=

# Vultr Object Storage (Call recordings)
VULTR_ACCESS_KEY_ID=
VULTR_SECRET_ACCESS_KEY=
VULTR_ENDPOINT_URL=https://blr1.vultrobjects.com
VULTR_BUCKET_NAME=getqualify-recordings
VULTR_REGION=us-east-1

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_REDIRECT_URI=https://voice.example.com/api/integrations/calendar/callback
CALENDAR_ENCRYPTION_KEY=

# Dograh Post-Call Webhook Secret
DOGRAH_WEBHOOK_SECRET=

# ---- Monitoring & Error Tracking (Phase 5) ---------------------------------
# Sentry DSN (optional, free tier: 5,000 events/month)
SENTRY_DSN=

# ---- Scaling & Background Workers (Phase 7) --------------------------------
REDIS_URL=redis://redis:6379
RAZORPAY_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
